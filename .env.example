# ---------------------------------------------------------------------------
# Backend (FastAPI). Copy to backend/.env for local development.
# NEVER commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# Anthropic API key. Server-side only — it is read by the FastAPI process and is
# never sent to, or referenced by, the browser. Without it the app still runs:
# explanations and Q&A fall back to a deterministic read-out of the same computed
# figures, and the UI labels them as such.
ANTHROPIC_API_KEY=

# Model used for explanations and Q&A.
MODEL_NAME=claude-sonnet-5

# Deployed frontend origin, used to build the CORS allowlist. Comma-separated for
# several origins. localhost:3000 is always permitted for local development, so
# this is only needed in production.
# e.g. FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=

# Optional
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend (Next.js). Copy to frontend/.env.local for local development.
# ---------------------------------------------------------------------------

# Base URL of the backend API. NEXT_PUBLIC_ variables are inlined into the
# browser bundle, so only put non-secret values here.
# Local:      http://localhost:8000
# Production: https://your-service.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Do NOT create NEXT_PUBLIC_ANTHROPIC_API_KEY or anything like it. Any
# NEXT_PUBLIC_ value is publicly readable in the shipped JavaScript.
